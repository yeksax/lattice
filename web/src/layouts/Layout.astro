---
import '@fontsource-variable/newsreader/standard.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  solidHeader?: boolean;
  localize?: boolean;
}

const { title, description, solidHeader = false, localize = false } = Astro.props;
const github = 'https://github.com/yeksax/lattice';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fdfdfc" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <noscript>
      <style>
        .reveal {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body data-localized-page={localize || undefined}>
    <a
      href="#main"
      class="fixed top-3 left-3 z-100 -translate-y-24 rounded-full border border-ink bg-surface px-4 py-2 text-sm focus:translate-y-0"
    >
      Skip to content
    </a>

    <header class:list={['site-header', { 'is-solid': solidHeader }]}>
      <div class="shell flex h-[4.5rem] items-center justify-between gap-6">
        <a href="/" class="text-ink" aria-label="Lattice home">
          <span class="font-serif text-[23px] leading-none" style="font-variation-settings: 'opsz' 24;">
            lattice
          </span>
        </a>
        <nav class="flex items-center gap-6 sm:gap-9" aria-label="Main">
          <a href="/#how" class="nav-link hidden sm:block">How it works</a>
          <a href="/#margin" class="nav-link hidden sm:block">The margin</a>
          <a href="/#skill" class="nav-link hidden md:block">Skill</a>
          <a href={github} class="nav-link" rel="noopener">GitHub</a>
          <a
            href="/download"
            class="inline-flex h-10 items-center rounded-full bg-ink px-5 text-[14.5px] font-medium text-paper transition-colors duration-200 hover:bg-[#2f2f2c]"
          >
            Download
          </a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="border-t border-rule">
      <div class="shell grid gap-10 py-12 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start sm:gap-16">
        <div>
          <span class="font-serif text-[19px] text-ink" style="font-variation-settings: 'opsz' 20; font-weight: 400;">
            lattice
          </span>
          <p class="micro mt-2 max-w-[38ch]">
            A local-first library for the reports your agents write.
          </p>
        </div>
        <div class="flex flex-wrap items-start gap-x-10 gap-y-6 text-[14.5px] text-ink2">
          <div class="flex flex-col gap-2.5">
            <a href="/download" class="transition-colors duration-200 hover:text-ink">Download</a>
            <a href="/#skill" class="transition-colors duration-200 hover:text-ink">Report skill</a>
          </div>
          <div class="flex flex-col gap-2.5">
            <a href={github} class="transition-colors duration-200 hover:text-ink" rel="noopener">Source</a>
            <a href={`${github}/blob/main/LICENSE`} class="transition-colors duration-200 hover:text-ink" rel="noopener">
              MIT license
            </a>
          </div>
          {
            localize && (
              <div aria-label="Language" class="flex flex-col gap-2.5">
                <button class="locale-option" type="button" data-locale-option="en">
                  English
                </button>
                <button class="locale-option" type="button" data-locale-option="pt-BR">
                  Português
                </button>
              </div>
            )
          }
        </div>
      </div>
    </footer>

    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
