---
/**
 * Working miniatures of the reader, one per margin panel.
 *
 * Every piece here is lifted from the real product: the round anchor marker and
 * the thread card come from `cmd/lattice/dashboard/comment.js`, the terminal
 * transcript is the actual output of `lattice threads` and `lattice reply`, the
 * checklist rows are the `data-lattice-state` items the state bridge persists,
 * and the poll is the `.opt / .fill / .pct` markup the skill emits. Nothing is
 * a drawing of a product: it is the product, at a smaller size.
 *
 * The two shape systems are the product's own. A report is drawn with hairlines
 * and square corners; the Lattice chrome that floats over it is round. Keeping
 * both is what makes the miniature recognisable.
 */
export interface Props {
  kind: 'threads' | 'terminal' | 'state' | 'poll' | 'reader';
}

const { kind } = Astro.props;

const cuts = [
  { key: 'resize-uploads', label: 'Resize images on upload', cost: 780, money: '$780' },
  { key: 'staging-replica', label: 'Drop the staging replica', cost: 310, money: '$310' },
  { key: 'old-exports', label: 'Archive the 2023 exports', cost: 120, money: '$120' },
];

const options = [
  { key: 'A', label: 'Keep it', votes: 1 },
  { key: 'B', label: 'Drop it and watch', votes: 2 },
  { key: 'C', label: 'Ask the data team', votes: 0 },
];

/* All five miniatures read the same report, so the section moves between them. */
const outline = [
  {
    label: 'Summary',
    excerpt: 'Three savings, nothing a reader would notice.',
    rows: [],
  },
  {
    label: 'Costs',
    excerpt: 'The image CDN came to $1,240, triple last month.',
    rows: [
      { initial: 'M', name: 'Marina Vasques', body: 'Triple last month.' },
      { initial: 'B', name: 'Bruno Sampaio', body: 'Nobody resized the hero images.' },
    ],
  },
  {
    label: 'Cuts',
    excerpt: 'Resize on upload, drop the staging replica.',
    rows: [{ initial: 'M', name: 'Marina Vasques', body: 'Nothing user-facing. Confirmed.' }],
  },
  {
    label: 'Decision',
    excerpt: 'Ship the three this week.',
    rows: [],
  },
];

const shortcuts = [
  { cap: 'C', code: 'KeyC', label: 'Comment' },
  { cap: 'S', code: 'KeyS', shift: true, label: 'Share' },
  { cap: 'D', code: 'KeyD', shift: true, label: 'Download' },
];
---

{
  kind === 'threads' && (
    <div class="dm" data-demo="threads">
      <div class="dm-doc">
        <p class="dm-doc-head">Monthly bill</p>
        <div class="dm-line">
          <span>Object storage</span>
          <span class="dm-num">$310</span>
        </div>
        <div class="dm-line is-anchor" data-demo-anchor>
          <span>Image CDN</span>
          <span class="dm-num">$1,240</span>
          <button class="dm-marker" type="button" data-demo-marker aria-expanded="true">
            <span aria-hidden="true" data-demo-count>2</span>
            <span class="dm-sr">Open the thread on this line</span>
          </button>

          {/* Floats beside the marker and over the document, where the reader puts it. */}
          <div class="dm-pop" data-demo-pop>
            <div class="dm-pop-head">
              <strong>Image CDN</strong>
              <button class="dm-icon" type="button" data-demo-close>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
                  <path d="M6 6l12 12M18 6L6 18" />
                </svg>
                <span class="dm-sr">Close the thread</span>
              </button>
            </div>
            <div class="dm-pop-body">
              <p class="dm-thread-meta">
                <span data-demo-status>open · costs</span>
                <button class="dm-icon dm-resolve" type="button" data-demo-resolve aria-pressed="false">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m5 12.5 4.5 4.5L19 7.5" />
                  </svg>
                  <span class="dm-sr">Resolve this thread</span>
                </button>
              </p>
              <article class="dm-comment">
                <span class="dm-avatar" aria-hidden="true">M</span>
                <div>
                  <p class="dm-comment-head">
                    <b>Marina Vasques</b>
                    <time>2h</time>
                  </p>
                  <p class="dm-comment-body">Triple last month.</p>

                  {/* Chips first, then the two buttons that add to them. */}
                  <p class="dm-reactions">
                    {[
                      { emoji: '👍', count: 2, mine: false },
                      { emoji: '✅', count: 1, mine: true },
                      { emoji: '👀', count: 0, mine: false },
                      { emoji: '🎉', count: 0, mine: false },
                    ].map((chip) => (
                      <button
                        class:list={['dm-chip', chip.mine && 'is-mine']}
                        type="button"
                        data-demo-chip
                        data-emoji={chip.emoji}
                        data-base={chip.count}
                        aria-pressed={chip.mine}
                        hidden={chip.count === 0}
                      >
                        <span aria-hidden="true">{chip.emoji}</span>
                        <span class="dm-chip-count" data-demo-chip-count>
                          {chip.count}
                        </span>
                      </button>
                    ))}

                    <span class="dm-reaction-add">
                      <button class="dm-icon" type="button" data-demo-react aria-expanded="false">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <circle cx="12" cy="12" r="9" />
                          <path d="M8.2 14.2s1.6 2.2 3.8 2.2 3.8-2.2 3.8-2.2" />
                          <circle cx="9" cy="10" r="1" fill="currentColor" stroke="none" />
                          <circle cx="15" cy="10" r="1" fill="currentColor" stroke="none" />
                        </svg>
                        <span class="dm-sr">Add a reaction</span>
                      </button>
                      <span class="dm-picker" data-demo-picker hidden>
                        {['👍', '✅', '👀', '🎉'].map((emoji) => (
                          <button type="button" data-demo-pick data-emoji={emoji}>
                            <span aria-hidden="true">{emoji}</span>
                            <span class="dm-sr">{emoji}</span>
                          </button>
                        ))}
                      </span>
                    </span>

                    <button class="dm-icon" type="button" data-demo-reply-action>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20 15a2 2 0 0 1-2 2H8l-4 4V7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2z" />
                      </svg>
                      <span class="dm-sr">Reply in this thread</span>
                    </button>
                  </p>
                </div>
              </article>

              {/* Replies sit under the comment they answer, indented like the reader does it. */}
              <article class="dm-comment is-reply">
                <span class="dm-avatar" aria-hidden="true">B</span>
                <div>
                  <p class="dm-comment-head">
                    <b>Bruno Sampaio</b>
                    <time>1h</time>
                  </p>
                  <p class="dm-comment-body">Nobody resized the hero images.</p>
                </div>
              </article>
              <article class="dm-comment is-new" data-demo-mine hidden>
                <span class="dm-avatar" aria-hidden="true">Y</span>
                <div>
                  <p class="dm-comment-head">
                    <b>You</b>
                    <time>now</time>
                  </p>
                  <p class="dm-comment-body" data-demo-mine-body />
                </div>
              </article>
            </div>
            <form class="dm-pop-foot" data-demo-compose>
              <span class="dm-avatar" aria-hidden="true">Y</span>
              <span class="dm-composer">
                <label class="dm-sr" for="dm-reply">Start a new thread on this line</label>
                <input id="dm-reply" type="text" autocomplete="off" placeholder="Start a new thread" data-demo-input />
                <button class="dm-send" type="submit" data-demo-send>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 19V5" />
                    <path d="m6 11 6-6 6 6" />
                  </svg>
                  <span class="dm-sr">Send</span>
                </button>
              </span>
            </form>
          </div>
        </div>
        <div class="dm-line">
          <span>Managed Postgres</span>
          <span class="dm-num">$480</span>
        </div>
      </div>
    </div>
  )
}

{
  kind === 'terminal' && (
    <div class="dm dm-term" data-demo="terminal">
      <div class="dm-term-head">
        <span>costs</span>
        <button class="dm-btn" type="button" data-demo-run>
          <span data-demo-run-label>Run</span>
        </button>
      </div>
      <div class="dm-term-body" data-demo-term>{[
        { text: '$ lattice threads costs --open', prompt: true },
        { text: 'thr_7c41  open  #image-cdn  local' },
        { text: '  Marina Vasques: Triple last month.' },
        { text: '$ lattice reply costs thr_7c41 "resized on upload"', prompt: true },
        { text: '$ lattice threads costs --open', prompt: true },
        { text: 'thr_7c41  open  #image-cdn  local' },
        { text: '  Marina Vasques: Triple last month.' },
        { text: '  Agent: resized on upload' },
      ].map((line) => (
        <span class:list={['dm-term-line', line.prompt && 'is-prompt']} data-demo-line>{line.text}</span>
      ))}</div>
    </div>
  )
}

{
  kind === 'state' && (
    <div class="dm" data-demo="state">
      <div class="dm-doc">
        <p class="dm-doc-head">What we are cutting</p>
        {cuts.map((cut) => (
          <label class="dm-line dm-check">
            <input type="checkbox" data-demo-check data-key={cut.key} data-cost={cut.cost} />
            <span>{cut.label}</span>
            <span class="dm-num">{cut.money}</span>
          </label>
        ))}
      </div>
      <div class="dm-foot">
        <span>
          <span class="dm-num" data-demo-total>$0</span>
          <span> agreed</span>
        </span>
        <button class="dm-btn" type="button" data-demo-reopen>
          Reopen the file
        </button>
      </div>
    </div>
  )
}

{
  kind === 'poll' && (
    <div class="dm" data-demo="poll">
      <div class="dm-doc dm-poll" data-demo-pollbox>
        <p class="dm-doc-head">Drop the staging replica?</p>
        {options.map((option) => (
          <button class="dm-opt" type="button" data-demo-opt data-votes={option.votes}>
            <span class="dm-fill" data-demo-fill />
            <span class="dm-opt-row">
              <span>
                <span class="dm-key">{option.key}</span>
                {option.label}
              </span>
              <span class="dm-pct" data-demo-pct>-</span>
            </span>
          </button>
        ))}
      </div>
      <div class="dm-foot">
        <span>
          <span class="dm-num" data-demo-answered>3</span>
          <span> of 4 answered</span>
        </span>
        <span data-demo-hint>Click to vote</span>
      </div>
    </div>
  )
}

{
  kind === 'reader' && (
    <div class="dm" data-demo="reader">
      <div class="dm-reader">
        {/* The rail the reader actually draws: one bar per section, a dot where
            the discussion is, and a card that peeks at what is inside. */}
        <nav class="dm-rail" aria-label="Outline">
          {outline.map((entry, i) => (
            <button
              class:list={['dm-tick', entry.rows.length > 0 && 'has-comments']}
              type="button"
              data-demo-section
              data-label={entry.label}
              data-excerpt={entry.excerpt}
              data-rows={JSON.stringify(entry.rows)}
              aria-current={i === 1 ? 'true' : 'false'}
            >
              <span class="dm-bar" aria-hidden="true" />
              {entry.rows.length > 0 && <span class="dm-dot" aria-hidden="true" />}
              <span class="dm-sr">{entry.label}</span>
            </button>
          ))}
        </nav>

        <div class="dm-doc dm-page" data-demo-page>
          <p class="dm-doc-head" data-demo-section-title>Costs</p>
          <div class="dm-line">
            <span>Monthly run rate</span>
            <span class="dm-num" data-demo-figure>$2,030</span>
          </div>
          <div class="dm-skeleton" aria-hidden="true">
            <span />
            <span />
            <span />
          </div>
        </div>

        <div class="dm-peek" data-demo-peek hidden>
          {/* The kicker gives the card its context, the title names the section.
              Printing the section name in both is one word doing no work. */}
          <p class="dm-kicker">
            <span>costs</span>
            <span class="dm-count" data-demo-peek-count>2</span>
          </p>
          <p class="dm-peek-title" data-demo-peek-title>Costs</p>
          <p class="dm-peek-body" data-demo-peek-body>
            The image CDN came to $1,240, triple last month.
          </p>
          <div class="dm-peek-threads" data-demo-peek-threads>
            {[
              { initial: 'M', name: 'Marina Vasques', body: 'Triple last month.' },
              { initial: 'B', name: 'Bruno Sampaio', body: 'Nobody resized the hero images.' },
            ].map((row) => (
              <p class="dm-peek-thread" data-demo-peek-row>
                <span class="dm-avatar is-small" aria-hidden="true" data-demo-row-initial>
                  {row.initial}
                </span>
                <span>
                  <b data-demo-row-name>{row.name}</b>
                  <span data-demo-row-body>{row.body}</span>
                </span>
              </p>
            ))}
          </div>
        </div>
      </div>
      <div class="dm-foot">
        <span class="dm-keys">
          {shortcuts.map((shortcut) => (
            <button
              class="dm-cap"
              type="button"
              data-demo-cap
              data-code={shortcut.code}
              data-shift={shortcut.shift ? 'true' : 'false'}
            >
              <kbd>
                {shortcut.shift && <span aria-hidden="true">&#8679;</span>}
                {shortcut.cap}
              </kbd>
              <span>{shortcut.label}</span>
            </button>
          ))}
        </span>
        <button class="dm-btn" type="button" data-demo-save>
          Save the file
        </button>
      </div>
    </div>
  )
}

<style>
  /* ---------- shared frame ---------- */

  .dm {
    --dm-line: var(--color-rule);
    --dm-sub: #f0f0ed;
    width: 100%;
    max-width: 25rem;
    color: var(--color-ink);
    font-size: 13px;
    line-height: 1.45;
    text-align: left;
  }

  .dm-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* A report fragment: hairlines, square corners, the skill's own language. */
  .dm-doc {
    position: relative;
    border: 1px solid var(--dm-line);
    background: var(--color-surface);
  }

  .dm-doc-head {
    padding: 9px 14px;
    border-bottom: 1px solid var(--dm-line);
    color: var(--color-ink);
    font-size: 12px;
    font-weight: 500;
  }

  .dm-line {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    color: var(--color-ink2);
  }

  .dm-line + .dm-line {
    border-top: 1px solid var(--dm-line);
  }

  .dm-num {
    margin-left: auto;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  /* Wraps rather than squeezes: the reader's footer carries a shortcut legend
     and a button, and on a narrow phone those are two lines, not one crushed. */
  .dm-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 12px;
    margin-top: 10px;
    color: var(--color-muted);
    font-size: 11.5px;
  }

  .dm-btn {
    border: 1px solid var(--color-rule-strong);
    border-radius: 999px;
    padding: 4px 11px;
    color: var(--color-ink2);
    font-size: 11.5px;
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  @media (hover: hover) {
    .dm-btn:hover {
      border-color: var(--color-ink);
      color: var(--color-ink);
    }
  }

  .dm-btn:active {
    scale: 0.97;
  }

  /* ---------- 02 threads ---------- */

  /* The card leaves the flow, so the panel reserves the room it will need. */
  .dm[data-demo='threads'] {
    min-height: 26rem;
  }

  .dm-line.is-anchor {
    position: relative;
    isolation: isolate;
  }

  /* The anchor wash, exactly as comment.js paints it over a live document. */
  .dm-line.is-anchor::after {
    content: '';
    position: absolute;
    inset: -1px -4px;
    z-index: 0;
    border-radius: 8px;
    background: color-mix(in srgb, var(--color-ink) 7%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-ink) 62%, transparent);
    opacity: 0;
    pointer-events: none;
    transition: opacity 160ms cubic-bezier(0.2, 0, 0, 1);
  }

  .dm[data-open='true'] .dm-line.is-anchor::after {
    opacity: 1;
  }

  /* A finger cannot hover, and a tap that leaves the wash behind reads as a
     stuck state. Only a real cursor gets the preview. */
  @media (hover: hover) {
    .dm-line.is-anchor:hover::after {
      opacity: 1;
    }
  }

  .dm-marker {
    position: absolute;
    z-index: 1;
    top: -10px;
    right: -14px;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 2px solid var(--color-surface);
    border-radius: 50%;
    border-bottom-left-radius: 0;
    background: var(--color-ink);
    color: var(--color-paper);
    box-shadow:
      0 1px 3px rgb(115 115 115 / 0.12),
      0 4px 14px rgb(115 115 115 / 0.12);
    font-size: 11px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    transition:
      scale 160ms cubic-bezier(0.2, 0, 0, 1),
      box-shadow 160ms cubic-bezier(0.2, 0, 0, 1);
  }

  @media (hover: hover) {
    .dm-marker:hover {
      scale: 1.06;
    }
  }

  .dm-marker:active {
    scale: 0.96;
  }

  /* The thread card: round, floating, the reader's own chrome. It leaves the
     line it belongs to and sits over the document, beside its marker. */
  .dm-pop {
    position: absolute;
    z-index: 2;
    /* Hangs off the line it belongs to, without covering it. */
    top: calc(100% - 2px);
    right: 30px;
    width: min(20rem, calc(100% - 1rem));
    text-align: left;
    border-radius: 20px;
    background: var(--color-surface);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--color-ink) 8%, transparent),
      0 2px 6px rgb(115 115 115 / 0.08),
      0 18px 40px rgb(115 115 115 / 0.12);
    transition:
      opacity 200ms cubic-bezier(0.2, 0, 0, 1),
      transform 220ms cubic-bezier(0.2, 0, 0, 1);
  }

  .dm[data-open='false'] .dm-pop {
    opacity: 0;
    transform: translateY(-6px) scale(0.98);
    pointer-events: none;
  }

  .dm-pop-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 8px 11px 16px;
    box-shadow: inset 0 -1px 0 color-mix(in srgb, var(--color-ink) 7%, transparent);
    font-size: 12.5px;
  }

  .dm-pop-head strong {
    flex: 1;
    font-weight: 600;
  }

  .dm-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 26px;
    height: 26px;
    border-radius: 8px;
    color: var(--color-muted);
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .dm-icon svg {
    display: block;
    width: 14px;
    height: 14px;
  }

  @media (hover: hover) {
    .dm-icon:hover {
      background: var(--dm-sub);
      color: var(--color-ink);
    }
  }

  .dm-resolve[aria-pressed='true'] {
    background: color-mix(in srgb, var(--color-ink) 7%, transparent);
    color: var(--color-ink);
  }

  .dm-pop-body {
    padding: 12px 16px 14px;
  }

  .dm-thread-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: -4px -6px 8px 0;
    color: var(--color-muted);
    font-size: 10.5px;
  }

  .dm-thread-meta span {
    flex: 1;
  }

  .dm[data-resolved='true'] .dm-comment {
    opacity: 0.55;
  }

  /* Composer: the send button only lights up once there is something to send. */
  .dm-pop-foot {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px 12px;
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--color-ink) 7%, transparent);
  }

  .dm-composer {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 4px;
    min-width: 0;
    padding: 3px 3px 3px 12px;
    border-radius: 999px;
    background: var(--dm-sub);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-muted) 30%, transparent);
    transition: box-shadow 0.16s ease;
  }

  .dm-composer:focus-within {
    background: var(--color-surface);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-muted) 45%, transparent);
  }

  .dm-composer input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    color: var(--color-ink);
    font: inherit;
    outline: none;
  }

  .dm-composer input::placeholder {
    color: var(--color-ink2);
  }

  .dm-send {
    display: grid;
    place-items: center;
    flex: none;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--color-ink);
    color: var(--color-paper);
    cursor: pointer;
    transition: opacity 0.16s ease;
  }

  .dm-send svg {
    display: block;
    width: 13px;
    height: 13px;
  }

  .dm-send:disabled {
    opacity: 0.24;
    cursor: default;
  }

  .dm-send:not(:disabled):active {
    scale: 0.96;
  }

  .dm-comment {
    display: grid;
    grid-template-columns: 26px 1fr;
    gap: 10px;
    align-items: start;
  }

  .dm-comment + .dm-comment {
    margin-top: 12px;
  }

  /* An answer is indented under what it answers, so a thread reads as one. */
  .dm-comment.is-reply {
    margin-left: 34px;
  }

  .dm-comment.is-reply + .dm-comment.is-reply {
    margin-top: 10px;
  }

  .dm-comment.is-new {
    margin-top: 14px;
    padding-top: 14px;
    box-shadow: inset 0 1px 0 color-mix(in srgb, var(--color-ink) 7%, transparent);
  }

  /* ---- reactions ---- */

  .dm-reactions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
