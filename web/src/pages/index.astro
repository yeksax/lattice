---
import Layout from '../layouts/Layout.astro';
import MarginDemo from '../components/MarginDemo.astro';

const github = 'https://github.com/yeksax/lattice';
const skillRepo = 'https://github.com/yeksax/html-summary';

const losses = [
  'In chat, it scrolls away.',
  'In Markdown, it flattens.',
  'In a folder, it goes quiet.',
];

const moves = [
  {
    index: '01',
    title: 'Your agent writes one file.',
    text: 'Self-contained HTML with real hierarchy: tables, charts, polls, controls, and no external requests. The html-summary skill gives your agent a shape to follow.',
  },
  {
    index: '02',
    title: 'Lattice indexes it where it is.',
    text: 'Adding a report records its path, never a copy. The library stays searchable, and filesystem events keep it current while you work on the file in your editor.',
  },
  {
    index: '03',
    title: 'One report goes out. Not the library.',
    text: 'Publishing uploads a snapshot of the report you name, and it stays online with your laptop closed. Restrict it to your company domain and readers sign in with Google. Everyone else gets a 403.',
  },
];

type Demo = 'threads' | 'terminal' | 'state' | 'poll' | 'reader';

const marginPanels: Array<{
  kind: 'intro' | 'feature' | 'outro';
  title: string;
  text: string;
  demo?: Demo;
}> = [
  {
    kind: 'intro',
    title: 'What the margin adds.',
    text: 'Served through Lattice, a static file gains everything a document needs to be argued with, and gives none of it back to the source.',
  },
  {
    kind: 'feature',
    title: 'Threads anchored to a line',
    text: 'Comment on the exact row people argue about. The thread survives the next version of the file, and it can be resolved or reopened later.',
    demo: 'threads',
  },
  {
    kind: 'feature',
    title: 'Replies from the terminal',
    text: 'lattice threads prints the discussion and lattice reply answers it, so the agent that wrote the report can defend it.',
    demo: 'terminal',
  },
  {
    kind: 'feature',
    title: 'Decisions that persist',
    text: 'Ticked boxes, notes, and open sections remember themselves, shared with the team or private to one reader.',
    demo: 'state',
  },
  {
    kind: 'feature',
    title: 'Blind polls',
    text: 'Collect a vote beside the evidence. Nothing is revealed until the last reader has answered.',
    demo: 'poll',
  },
  {
    kind: 'feature',
    title: 'Live reload, an outline, and shortcuts',
    text: 'Save the file and every open reader repaints. A rail indexes the sections and marks where the discussion is. C starts a comment, shift S shares, shift D downloads.',
    demo: 'reader',
  },
  {
    kind: 'outro',
    title: 'Nothing is written back into the source.',
    text: 'Close Lattice and the report is still plain HTML that opens anywhere.',
  },
];
---

<Layout
  title="Lattice: a local-first library for agent-made reports"
  description="Your agents write HTML reports. Lattice indexes them where they sit, opens them locally, and keeps every question beside the line it is about. Local-first, open source, MIT licensed."
  localize
>
  <!-- ═══════════ hero ═══════════ -->
  <section class="hero relative min-h-[100dvh] overflow-hidden">
    <div class="absolute inset-0" aria-hidden="true">
      <picture class="block h-full w-full">
        <source srcset="/images/lattice-forest-record.webp" type="image/webp" />
        <img
          src="/images/lattice-forest-record.png"
          alt=""
          width="1440"
          height="560"
          class="h-full w-full object-cover object-center"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <div class="hero-scrim absolute inset-0"></div>
    </div>

    <div class="shell relative flex min-h-[100dvh] flex-col items-center justify-center pt-24 pb-16 text-center">
      <div class="mx-auto w-full max-w-[44rem]">
        <p class="brand-mark reveal">lattice</p>
        <h1 class="display reveal mx-auto mt-6 max-w-[20ch]" style="--d: 0.08s">
          Agents write the report. Your team writes in the margin.
        </h1>
        <p class="lede reveal mx-auto mt-7 max-w-[40ch]" style="--d: 0.14s">
          Lattice indexes those files where they sit, serves them locally, and keeps every question
          beside the line it is about.
        </p>
        <div class="reveal mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row sm:flex-wrap" style="--d: 0.2s">
          <a class="btn btn-primary w-full sm:w-auto" href="/download">Download Lattice</a>
          <a class="btn btn-ghost w-full sm:w-auto" href="#skill">Install the report skill</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ the loss ═══════════ -->
  <section class="loss relative overflow-hidden">
    <div class="loss-plate absolute inset-0" aria-hidden="true">
      <picture class="block h-full w-full">
        <source srcset="/images/lattice-forest-record.webp" type="image/webp" />
        <img
          src="/images/lattice-forest-record.png"
          alt=""
          width="1440"
          height="560"
          class="loss-photo h-full w-full object-cover object-[78%_42%]"
          loading="lazy"
          decoding="async"
        />
      </picture>
      <div class="loss-scrim absolute inset-0"></div>
    </div>

    <div class="shell band on-deep relative">
      <h2 class="h2 reveal max-w-[17ch]">The analysis was never the problem.</h2>
      <p class="copy reveal mt-7 max-w-[50ch]" style="--d: 0.08s">
        The file lands in a chat thread. The questions land somewhere else. The decision gets made
        in a third place, and six weeks later nobody can find any of the three.
      </p>
      <ul class="loss-grid reveal" style="--d: 0.14s">
        {
          losses.map((loss, i) => (
            <li class="loss-item">
              <span class="step-num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <p class="loss-line">{loss}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ═══════════ three moves ═══════════ -->
  <section id="how" class="band">
    <div class="shell">
      <h2 class="h2 reveal max-w-[16ch]">Three moves, and the file never changes.</h2>

      <ol class="moves mt-16 space-y-0 md:mt-20">
        {
          moves.map((move, i) => (
            <li
              class:list={[
                'reveal grid gap-4 border-t border-rule py-10 md:grid-cols-[5.5rem_minmax(0,1fr)] md:gap-10 md:py-12',
                i === moves.length - 1 && 'border-b',
              ]}
              style={`--d: ${0.06 + i * 0.05}s`}
            >
              <span class="step-num" aria-hidden="true">
                {move.index}
              </span>
              <div>
                <h3 class="h3">{move.title}</h3>
                <p class="copy mt-4 max-w-[54ch]">{move.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ═══════════ the margin (scroll carousel) ═══════════ -->
  <section id="margin" class="margin-carousel is-static bg-paper-2" data-margin-carousel>
    <div class="margin-viewport" data-margin-viewport>
      <span class="margin-rule" aria-hidden="true"></span>
      <div class="margin-track" data-margin-track>
        {
          marginPanels.map((panel, i) => (
            <article
              class:list={[
                'margin-panel',
                panel.kind === 'intro' && 'margin-panel-intro',
                panel.kind === 'outro' && 'margin-panel-outro',
              ]}
              data-margin-panel
            >
              <div class="shell">
                <div class="margin-panel-inner">
                  {panel.kind === 'feature' && (
                    <p class="margin-index" data-margin-fade aria-hidden="true">
                      {String(i + 1).padStart(2, '0')}
                    </p>
                  )}
                  <div class:list={['margin-panel-body', panel.demo && 'has-demo']}>
                    <div class="margin-panel-prose">
                      <h2
                        class:list={[panel.kind === 'intro' || panel.kind === 'outro' ? 'h2' : 'h3', 'max-w-[18ch]']}
                        data-margin-fade
                      >
                        {panel.title}
                      </h2>
                      <p
                        class:list={['copy mt-6 max-w-[42ch]', panel.kind === 'outro' && 'text-[17px]']}
                        data-margin-fade
                      >
                        {panel.text}
                      </p>
                    </div>
                    {
                      panel.demo && (
                        <div class="margin-panel-demo" data-margin-fade>
                          <MarginDemo kind={panel.demo} />
                        </div>
                      )
                    }
                  </div>
                </div>
              </div>
            </article>
          ))
        }
      </div>
      <nav class="margin-rail" data-margin-rail aria-label="The margin">
        {
          marginPanels.map((panel, i) => (
            <button class="margin-tick" type="button" data-margin-tick={i} aria-label={panel.title}>
              <span aria-hidden="true"></span>
            </button>
          ))
        }
      </nav>
    </div>
  </section>

  <!-- ═══════════ why HTML ═══════════ -->
  <section class="band border-t border-rule">
    <div class="shell">
      <h2 class="statement reveal max-w-[22ch]">
        One file goes from the agent to the meeting without a conversion step.
      </h2>
      <div class="reveal mt-14 grid gap-12 md:grid-cols-2 md:gap-20" style="--d: 0.1s">
        <div>
          <h3 class="h3">For readers</h3>
          <p class="copy mt-4">
            A report gets real hierarchy: comparisons, charts, controls, and a conclusion you can
            find in five seconds. It opens in a browser, with no viewer to install.
          </p>
        </div>
        <div>
          <h3 class="h3">For agents</h3>
          <p class="copy mt-4">
            HTML is a format agents already write, inspect, and revise. One self-contained file
            carries the content, the presentation, and the interaction together.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ the record ═══════════ -->
  <section class="relative overflow-hidden border-t border-rule">
    <div class="absolute inset-0" aria-hidden="true">
      <picture class="block h-full w-full">
        <source srcset="/images/lattice-forest-hero.webp" type="image/webp" />
        <img
          src="/images/lattice-forest-hero.png"
          alt=""
          width="1440"
          height="940"
          class="h-full w-full object-cover object-[70%_45%]"
          loading="lazy"
          decoding="async"
        />
      </picture>
      <div class="record-scrim absolute inset-0"></div>
    </div>
    <div class="shell relative py-28 md:py-36">
      <h2 class="h2 reveal max-w-[14ch]">Past work keeps working.</h2>
      <p class="copy reveal mt-7 max-w-[48ch]" style="--d: 0.08s">
        Audits, plans, and comparisons stack up into something the team can search, instead of a
        trail of links nobody clicks twice. The next question starts from what you already know.
      </p>
    </div>
  </section>

  <!-- ═══════════ the skill ═══════════ -->
  <section id="skill" class="band border-t border-rule">
    <div class="shell">
      <div class="mx-auto max-w-[40rem] text-center">
        <h2 class="h2 reveal mx-auto max-w-[16ch]">The format, without the library.</h2>
        <p class="copy reveal mx-auto mt-7 max-w-[54ch]" style="--d: 0.08s">
          html-summary is the skill that teaches a compatible agent how a summary should be built:
          dense, self-contained, no external requests. Install it on its own and keep the files
          wherever you like. Add Lattice when you want the library and the margin around them.
        </p>
        <div class="reveal mt-10 flex flex-col items-center gap-5" style="--d: 0.14s">
          <div class="command">
            <span data-prompt aria-hidden="true">$</span>
            <span id="skill-code">npx skills add yeksax/html-summary</span>
            <button class="copy-btn ml-1" data-copy-target="#skill-code" type="button">
              <span data-copy-label>Copy</span>
            </button>
          </div>
          <p class="micro max-w-[42ch]">
            No daemon, no CLI, no configuration. The skill is MIT licensed too.
          </p>
          <a
            href={`${skillRepo}/blob/main/skills/html-summary/SKILL.md`}
            class="link-ink text-[15px]"
            rel="noopener"
          >
            Inspect the skill
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ start ═══════════ -->
  <section class="band border-t border-rule bg-paper-2">
    <div class="shell">
      <div class="mx-auto max-w-[40rem] text-center">
        <h2 class="h2 reveal mx-auto max-w-[22ch]">Start with one report you already have.</h2>
        <p class="copy reveal mx-auto mt-7 max-w-[48ch]" style="--d: 0.08s">
          Install the binary, point it at a finished HTML file, and open your library. The CLI, the
          daemon, the dashboard, and the skill are MIT licensed: run them, read them, fork them.
        </p>
        <div class="reveal mt-10 flex flex-wrap items-center justify-center gap-3.5" style="--d: 0.14s">
          <a class="btn btn-primary" href="/download">Download Lattice</a>
          <a class="btn btn-ghost" href={github} rel="noopener">Read the source</a>
        </div>
        <p class="micro reveal mt-8" style="--d: 0.18s">One binary. macOS, Linux, and Windows.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-scrim {
    background:
      radial-gradient(ellipse 68% 58% at 50% 46%, rgb(253 253 252 / 0.94) 0%, rgb(253 253 252 / 0.78) 48%, rgb(253 253 252 / 0.35) 78%, rgb(253 253 252 / 0.12) 100%),
      linear-gradient(180deg, rgb(253 253 252 / 0.7) 0%, rgb(253 253 252 / 0.25) 35%, rgb(253 253 252 / 0.35) 70%, rgb(253 253 252 / 0.92) 100%);
  }

  .record-scrim {
    background:
      linear-gradient(90deg, rgb(253 253 252 / 0.94) 0%, rgb(253 253 252 / 0.78) 42%, rgb(253 253 252 / 0.35) 100%),
      linear-gradient(180deg, rgb(253 253 252 / 0.55) 0%, rgb(253 253 252 / 0.18) 40%, rgb(253 253 252 / 0.55) 100%);
  }

  @media (max-width: 767px) {
    .hero-scrim {
      background:
        radial-gradient(ellipse 100% 70% at 50% 42%, rgb(253 253 252 / 0.94) 0%, rgb(253 253 252 / 0.8) 55%, rgb(253 253 252 / 0.45) 100%),
        linear-gradient(180deg, rgb(253 253 252 / 0.85) 0%, rgb(253 253 252 / 0.55) 45%, rgb(253 253 252 / 0.92) 100%);
    }

    .record-scrim {
      background: linear-gradient(
        180deg,
        rgb(253 253 252 / 0.94) 0%,
        rgb(253 253 252 / 0.78) 45%,
        rgb(253 253 252 / 0.94) 100%
      );
    }
  }

  .brand-mark {
    font-family: var(--font-serif);
    font-size: clamp(3.2rem, 8vw, 5.75rem);
    font-weight: 400;
    font-variation-settings: 'opsz' 60;
    letter-spacing: -0.035em;
    line-height: 0.92;
    color: var(--color-ink);
  }

  .display {
    font-size: clamp(2rem, 3.8vw, 3.35rem);
    line-height: 1.08;
  }

  :global(html[lang='pt-BR']) .display {
    font-size: clamp(1.85rem, 3.4vw, 2.9rem);
  }

  :global(html[lang='pt-BR']) .brand-mark {
    font-size: clamp(2.8rem, 7vw, 5rem);
  }

  /* The ordinal shares a line with the step title, so it needs the heading's
     lead. In the loss grid it sits above its line and takes none. */
  .moves .step-num {
    padding-top: 0.35rem;
  }

  /* ---- the loss ----
     The one inverted band on the page. The edges stay hard — a fade to paper
     just reads as a washed-out grey band — so what ties it to the rest is the
     picture: the hero's forest, read back in negative. */

  .loss-plate {
    background: var(--color-deep);
  }

  /* Negative of the same plate the hero opens on: the ink turns to light and
     the paper turns to dark, so the mist is already the right value. */
  .loss-photo {
    filter: invert(1) contrast(1.08);
    opacity: 0.4;
  }

  /* Holds the left half at reading contrast and lets the treeline keep the
     right, which is where the old layout ran out of content. */
  .loss-scrim {
    background:
      linear-gradient(90deg, rgb(14 14 13 / 0.96) 0%, rgb(14 14 13 / 0.88) 38%, rgb(14 14 13 / 0.6) 66%, rgb(14 14 13 / 0.4) 100%),
      linear-gradient(180deg, rgb(14 14 13 / 0.72) 0%, rgb(14 14 13 / 0.28) 45%, rgb(14 14 13 / 0.8) 100%);
  }

  /* Closed on all four sides. The three losses are the section's punchline, so
     they carry heading ink rather than the body grey. */
  .loss-grid {
    display: grid;
    margin-top: 4rem;
    border-top: 1px solid var(--color-deep-rule);
    border-bottom: 1px solid var(--color-deep-rule);
  }

  .loss-item {
    padding: 1.75rem 0;
    border-top: 1px solid var(--color-deep-rule);
  }

  .loss-item:first-child {
    border-top: 0;
  }

  .loss-line {
    margin-top: 0.8rem;
    color: var(--color-deep-ink);
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    line-height: 1.35;
    text-wrap: balance;
  }

  @media (min-width: 640px) {
    .loss-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .loss-item {
      padding: 2.25rem 2rem;
      border-top: 0;
      border-left: 1px solid var(--color-deep-rule);
    }

    .loss-item:first-child {
      padding-left: 0;
      border-left: 0;
    }

    .loss-item:last-child {
      padding-right: 0;
    }
  }

  @media (min-width: 768px) {
    .loss-grid {
      margin-top: 5rem;
    }
  }

  /* ---- margin scroll carousel ----
     The section is named after a margin, so it is built on one: a single
     hairline runs down the viewport, the panel index sits to its left, and the
     prose sits to its right. In the pinned mode the rule belongs to the
     viewport, not to the panels, so the text slides past a margin that stays.

     Mobile: stacked list (default).
     Desktop: JS upgrades to a pinned horizontal scrub. */

  .margin-carousel {
    position: relative;
    --margin-col: 5.5rem;
    --margin-gutter: 2.5rem;
  }

  /* Sits above the screen-wide backdrop the body paints while locked. */
  .margin-carousel.is-locked {
    z-index: 1;
  }

  .margin-viewport {
    position: relative;
  }

  .margin-track {
    display: block;
  }

  .margin-panel {
    display: block;
    padding: 4.5rem 0;
    border-top: 1px solid var(--color-rule);
  }

  .margin-panel:first-child {
    border-top: 0;
    padding-top: 5.5rem;
  }

  .margin-panel:last-child {
    padding-bottom: 5.5rem;
  }

  .margin-panel-inner {
    max-width: 44rem;
    text-align: left;
  }

  .margin-index {
    margin-bottom: 1.25rem;
    color: var(--color-muted);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  /* The rule is a pinned-mode device; the stacked list rules itself with the
     panel borders it already has. */
  .margin-rule,
  .margin-rail {
    display: none;
  }

  @media (min-width: 768px) {
    .margin-panel-inner {
      display: grid;
      grid-template-columns: var(--margin-col) minmax(0, 1fr);
      max-width: none;
    }

    .margin-index {
      grid-column: 1;
      margin-bottom: 0;
      padding-top: 0.4rem;
    }

    .margin-panel-body {
      grid-column: 2;
      padding-left: 2rem;
    }

    /* Prose on the left, the thing it describes on the right. */
    .margin-panel-body.has-demo {
      display: grid;
      grid-template-columns: minmax(0, 23rem) minmax(0, 1fr);
      gap: 3.5rem;
      /* Index, headline and miniature all start on the same line. */
      align-items: start;
    }
  }

  .margin-panel-demo {
    margin-top: 2.5rem;
  }

  /* ---- pinned mode ----
     The same machine at every width: the viewport holds one screen, the track
     carries the panels across it. Only the rail changes shape, because a phone
     has no room on the right for it. */

  /* Two heights, because a phone has two: the URL bar slides away and the
     screen grows under it. The frame takes the large one, so the section paints
     over every pixel the browser can show and never lets the next band peek out
     from under it. The panel inside takes the small one, so its content sits in
     the strip that is on screen in either state. dvh is no use here: GSAP pins
     with position: fixed, and inside a fixed element Chrome on Android resolves
     dvh against the large viewport anyway. */
  .margin-carousel:not(.is-static) .margin-viewport {
    height: 100lvh;
    overflow: hidden;
  }

  .margin-carousel:not(.is-static) .margin-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    height: 100%;
    will-change: transform;
  }

  /* The header leaves while the carousel is locked, so the only thing a panel
     has to clear is the rail lying along the bottom. */
  .margin-carousel:not(.is-static) .margin-panel {
    display: flex;
    height: 100svh;
    align-items: center;
    padding: 2.5rem 0 3.5rem;
    border-top: 0;
  }

  /* One screen is all the room there is, so the miniature sits closer to the
     sentence it answers than it does in the stacked list, and the number sits
     closer to the heading it counts. */
  .margin-carousel:not(.is-static) .margin-panel-demo {
    margin-top: 1rem;
  }

  .margin-carousel:not(.is-static) .margin-index {
    margin-bottom: 0.75rem;
  }

  /* The rail lies along the bottom, where a thumb already is — the bottom of
     the panel, not of the frame, so the URL bar never covers it. */
  .margin-carousel:not(.is-static) .margin-rail {
    display: flex;
    position: absolute;
    right: 0;
    bottom: calc(100lvh - 100svh + 1.25rem);
    left: 0;
    align-items: center;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .margin-panel-demo {
      margin-top: 0;
    }

    /* Stacked at desktop width (reduced motion): each panel carries its own
       rule, since there is no pinned viewport to hang one in. */
    .margin-carousel.is-static .margin-panel-body {
      border-left: 1px solid var(--color-rule-strong);
    }

    .margin-carousel:not(.is-static) .margin-panel {
      padding: 0;
    }

    .margin-carousel:not(.is-static) .margin-rule {
      display: block;
      position: absolute;
      top: 0;
      bottom: 0;
      /* Lands exactly on the grid seam inside .shell (max-w 1120, px-10). */
      left: calc(max(var(--margin-gutter), (100% - 1120px) / 2 + var(--margin-gutter)) + var(--margin-col));
      width: 1px;
      background: var(--color-rule-strong);
      mask-image: linear-gradient(180deg, transparent, #000 16%, #000 84%, transparent);
      pointer-events: none;
    }

    /* Back to a column against the right edge, beside the panel it indexes. */
    .margin-carousel:not(.is-static) .margin-rail {
      top: 50%;
      right: var(--margin-gutter);
      bottom: auto;
      left: auto;
      flex-direction: column;
      align-items: flex-end;
      justify-content: flex-start;
      transform: translateY(-50%);
    }
  }

  .margin-tick {
    padding: 0.55rem 0 0.55rem 1.5rem;
    cursor: pointer;
  }

  .margin-tick span {
    display: block;
    width: 1.5rem;
    height: 1px;
    background: var(--color-rule-strong);
    transition:
      width 0.4s var(--ease-out-expo),
      background-color 0.3s ease;
  }

  .margin-tick:hover span {
    width: 2rem;
    background: var(--color-ink2);
  }

