---
import Layout from '../layouts/Layout.astro';

const github = 'https://github.com/yeksax/lattice';
const releaseBase = `${github}/releases/download/continuous`;
const skillRepo = 'https://github.com/yeksax/html-summary';

const cliBuilds = [
  { os: 'macos', label: 'macOS, Apple Silicon', file: 'lattice-darwin-arm64' },
  { os: 'macos', label: 'macOS, Intel', file: 'lattice-darwin-amd64' },
  { os: 'linux', label: 'Linux, arm64', file: 'lattice-linux-arm64' },
  { os: 'linux', label: 'Linux, x86-64', file: 'lattice-linux-amd64' },
  { os: 'windows', label: 'Windows, x86-64', file: 'lattice-windows-amd64.exe' },
];
---

<Layout
  title="Download Lattice for macOS, Linux, or Windows"
  description="Download the Lattice CLI for macOS, Linux, or Windows, verify its SHA-256 checksum, or install the standalone report skill."
  solidHeader
  localize
>
  <!-- ═══════════ intro ═══════════ -->
  <section class="pt-36 pb-14 md:pt-40">
    <div class="shell max-w-[52rem]">
      <h1 class="display reveal">Run Lattice on your machine.</h1>
      <p id="download-detect" class="lede reveal mt-7" style="--d: 0.08s">Checking your system…</p>
      <p class="note reveal mt-4" style="--d: 0.12s">CLI, local daemon, and dashboard in one binary. MIT licensed.</p>
    </div>
  </section>

  <!-- ═══════════ builds ═══════════ -->
  <section id="cli" class="band border-t border-rule">
    <div class="shell">
      <h2 class="h2 reveal max-w-[18ch]">One binary for the local workflow.</h2>
      <p class="lede reveal mt-6 max-w-[54ch]" style="--d: 0.08s">
        Every push to <code>main</code> publishes five builds to the
        <a href={`${github}/releases/tag/continuous`} class="link-ink" rel="noopener">continuous release</a>.
        Run any Lattice command and the local service starts on demand.
      </p>

      <div class="reveal mt-10" style="--d: 0.12s">
        <div data-when-os="macos">
          <div class="cmdblock">
            <div class="cmdblock-head">
              <span>macOS default, Apple Silicon</span>
              <button class="copy-btn" data-copy-target="#cli-macos" type="button"><span data-copy-label>Copy</span></button>
            </div>
            <pre class="cmdblock-body"><code id="cli-macos">curl -fsSL {releaseBase}/lattice-darwin-arm64 \
  -o /usr/local/bin/lattice &amp;&amp; chmod +x /usr/local/bin/lattice</code></pre>
          </div>
          <p class="micro mt-3">Using an Intel Mac? Choose <code>lattice-darwin-amd64</code> below.</p>
        </div>

        <div data-when-os="linux">
          <div class="cmdblock">
            <div class="cmdblock-head">
              <span>Linux default, x86-64</span>
              <button class="copy-btn" data-copy-target="#cli-linux" type="button"><span data-copy-label>Copy</span></button>
            </div>
            <pre class="cmdblock-body"><code id="cli-linux">curl -fsSL {releaseBase}/lattice-linux-amd64 \
  -o /usr/local/bin/lattice &amp;&amp; chmod +x /usr/local/bin/lattice</code></pre>
          </div>
          <p class="micro mt-3">
            Writing to <code>/usr/local/bin</code> may require <code>sudo</code>. The arm64 build is below.
          </p>
        </div>

        <div data-when-os="windows">
          <div class="cmdblock">
            <div class="cmdblock-head">
              <span>Windows, PowerShell</span>
              <button class="copy-btn" data-copy-target="#cli-windows" type="button"><span data-copy-label>Copy</span></button>
            </div>
            <pre class="cmdblock-body"><code id="cli-windows">irm {releaseBase}/lattice-windows-amd64.exe -OutFile lattice.exe</code></pre>
          </div>
          <p class="micro mt-3">Move <code>lattice.exe</code> into a directory on your <code>PATH</code>.</p>
        </div>

        <div data-when-os="unknown">
          <p class="text-[15px] text-ink2">Choose your platform from the builds below.</p>
        </div>
      </div>

      <div class="download-table reveal mt-10" style="--d: 0.16s">
        {
          cliBuilds.map((build) => (
            <div class="os-row" data-os-row={build.os}>
              <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 px-5 py-4 text-[14.5px]">
                <span class="flex items-center gap-3 text-ink">
                  {build.file}
                  <span class="detected-tag rounded-full border border-ink px-2 py-0.5 text-[11px] text-ink">
                    matching OS
                  </span>
                </span>
                <span class="flex items-center gap-6">
                  <span class="text-muted">{build.label}</span>
                  <a href={`${releaseBase}/${build.file}`} class="link-ink">Download</a>
                </span>
              </div>
            </div>
          ))
        }
      </div>
      <p class="micro reveal mt-4" style="--d: 0.18s">
        Rename the download to <code>lattice</code> and place it on your <code>PATH</code>. You are ready.
      </p>
    </div>
  </section>

  <!-- ═══════════ verify ═══════════ -->
  <section id="verify" class="band border-t border-rule">
    <div class="shell">
      <h2 class="h2 reveal max-w-[18ch]">Check the file before you run it.</h2>
      <p class="lede reveal mt-6 max-w-[54ch]" style="--d: 0.08s">
        Each release includes
        <a href={`${releaseBase}/SHA256SUMS.txt`} class="link-ink" rel="noopener">SHA256SUMS.txt</a>
        beside the binaries. Download the checksum file from the same release, then run the matching
        command in the directory that contains your binary.
      </p>

      <div class="reveal mt-10 grid grid-cols-1 gap-5 xl:grid-cols-2" style="--d: 0.12s">
        <div class="cmdblock">
          <div class="cmdblock-head">
            <span>macOS and Linux</span>
            <button class="copy-btn" data-copy-target="#verify-unix" type="button"><span data-copy-label>Copy</span></button>
          </div>
          <pre class="cmdblock-body"><code id="verify-unix">curl -fsSLO {releaseBase}/SHA256SUMS.txt
shasum -a 256 --check --ignore-missing SHA256SUMS.txt</code></pre>
        </div>
        <div class="cmdblock">
          <div class="cmdblock-head">
            <span>Windows, PowerShell</span>
            <button class="copy-btn" data-copy-target="#verify-win" type="button"><span data-copy-label>Copy</span></button>
          </div>
          <pre class="cmdblock-body"><code id="verify-win">certutil -hashfile lattice-windows-amd64.exe SHA256
<span class="cm"># compare with the matching line in SHA256SUMS.txt</span></code></pre>
        </div>
      </div>
      <p class="micro mt-3">
        On Linux, <code>sha256sum --check --ignore-missing SHA256SUMS.txt</code> works too.
      </p>
    </div>
  </section>

  <!-- ═══════════ the skill ═══════════ -->
  <section id="skill" class="band border-t border-rule">
    <div class="shell">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)] lg:items-start lg:gap-14">
        <div>
          <h2 class="h2 reveal max-w-[16ch]">Want the format without the library?</h2>
          <p class="copy reveal mt-6" style="--d: 0.08s">
            One command installs the skill that teaches a compatible agent to write concise,
            self-contained HTML reports. No daemon, no CLI, no configuration.
          </p>
          <p class="reveal mt-5" style="--d: 0.12s">
            <a href={`${skillRepo}/blob/main/skills/html-summary/SKILL.md`} class="link-ink text-[15px]" rel="noopener">
              Inspect the skill
            </a>
          </p>
        </div>
        <div class="reveal lg:pt-2" style="--d: 0.1s">
          <div class="cmdblock">
            <div class="cmdblock-head">
              <span>html-summary, standalone</span>
              <button class="copy-btn" data-copy-target="#skill-only-code" type="button"><span data-copy-label>Copy</span></button>
            </div>
            <pre class="cmdblock-body"><code id="skill-only-code">npx skills add yeksax/html-summary</code></pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════ source ═══════════ -->
  <section id="source" class="band border-t border-rule">
    <div class="shell">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)] lg:items-start lg:gap-14">
        <div>
          <h2 class="h2 reveal max-w-[16ch]">Prefer to compile it yourself?</h2>
          <p class="copy reveal mt-6" style="--d: 0.08s">
            Lattice is a single Go module. Clone the repository and build the CLI directly.
          </p>
          <p class="reveal mt-5" style="--d: 0.12s">
            <a href={`${github}/releases/tag/continuous`} class="link-ink text-[15px]" rel="noopener">
              Browse every published build on GitHub Releases
            </a>
          </p>
        </div>
        <div class="reveal lg:pt-2" style="--d: 0.1s">
          <div class="cmdblock">
            <div class="cmdblock-head">
              <span>requires Go, builds locally</span>
              <button class="copy-btn" data-copy-target="#source-code" type="button"><span data-copy-label>Copy</span></button>
            </div>
            <pre class="cmdblock-body"><code id="source-code">git clone https://github.com/yeksax/lattice.git
cd lattice
go build -o lattice ./cmd/lattice</code></pre>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
